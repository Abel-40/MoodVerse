# ===========================================================================
# MoodVerse
# ===========================================================================

# ---------------------------------------------------------------------------
# Secrets and credentials  -- never commit
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# Proprietary LLM prompts  -- not for publication
#
# annotation/runs/ is deliberately NOT ignored: the enrichment produced by the
# development agent is version-controlled data, and build_enrichment.py replays
# it. Only the prompt templates are withheld.
# ---------------------------------------------------------------------------
data/processed/enrichment/annotation/prompts/
annotate_verse.md

# ---------------------------------------------------------------------------
# Generated pipeline artefacts
#
# Deterministic outputs, not inputs: same sources + same pipeline version
# reproduce them byte-for-byte. The unified corpus alone exceeds GitHub's
# 100 MB per-file limit.
#
#   python pipeline/phase0/build_unified_corpus.py
#   python pipeline/phase1/build_priors.py
#   python pipeline/phase1/build_enrichment.py --bootstrap
# ---------------------------------------------------------------------------
data/processed/unified_scripture_corpus.jsonl
data/processed/cross_reference_graph.json
data/processed/enrichment/priors/deterministic_priors.jsonl
data/processed/enrichment/curation/enrichment.jsonl
data/processed/enrichment/curation/decisions.jsonl
docs/*
# Generated documentation -- rebuilt by pipeline/phase1/build_docs.py
data/processed/enrichment/taxonomy/definitions.md
data/processed/enrichment/mappings/mapping_rules.md
data/processed/enrichment/priors/prior_rules.md

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# OS and editor noise
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.swp
*~
*.tmp
*.log
