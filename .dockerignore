# The build context is the repository root, so that docker/ and backend/ can
# both be read by one Dockerfile. data/ alone is ~350 MB and belongs in the
# `ingest` bind mount, never in an image layer - hence deny-all, then
# re-include only what is actually copied.
*
!backend/
!docker/backend-entrypoint.sh

# Never ship into an image, even from a re-included directory.
backend/.env
backend/.env.*
backend/.venv/
backend/venv/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/*.egg-info/
backend/**/*.log
