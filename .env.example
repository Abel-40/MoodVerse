# MoodVerse. Copy to .env and fill in: cp .env.example .env
# Read by docker-compose.yml (every service) and by the backend directly when
# it runs outside Docker. Never commit .env.

# --- compose: host ports and database credentials ---------------------------
# Both host ports bind to loopback only and avoid 5432/8000.
POSTGRES_USER=moodverse
POSTGRES_PASSWORD=moodverse
POSTGRES_DB=moodverse
DB_HOST_PORT=55433
API_HOST_PORT=8080

# --- database ---------------------------------------------------------------
# This value is for running the backend on the host. Inside Compose the
# services override it to reach the `db` container instead.
DATABASE_URL=postgresql+psycopg://moodverse:moodverse@localhost:55433/moodverse
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- web clients -------------------------------------------------------------
# Comma-separated exact origins allowed to call the API from a browser. The
# React Native app needs none of this; the Next.js API console does. It serves
# on 3200 because 3000 falls inside a reserved TCP range on some Windows
# machines; both are listed so either works.
CORS_ALLOWED_ORIGINS=http://localhost:3200,http://127.0.0.1:3200,http://localhost:3000

# --- runtime AI --------------------------------------------------------------
# Analyses the user's reflection and nothing else; never produces scripture.
# `heuristic` needs no key and costs nothing.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- embeddings and retrieval ------------------------------------------------
# EMBEDDING_DIMENSION must match the pgvector column.
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSION=768
RETRIEVAL_CANDIDATE_LIMIT=200
RETRIEVAL_RESULT_LIMIT=5

# --- auth: JWT ---------------------------------------------------------------
# Both secrets MUST be replaced before any non-local deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-insecure-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Signs the session cookie Authlib uses for OIDC state/nonce, nothing else.
SESSION_SECRET_KEY=dev-insecure-session-secret-change-me

# --- auth: Google OIDC -------------------------------------------------------
# Leave the client id/secret unset to disable /auth/oidc/*, which then reports
# 503 instead of preventing startup. Credentials:
# https://console.cloud.google.com/apis/credentials - authorised redirect URI
# is {PUBLIC_BASE_URL}/auth/oidc/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OIDC_GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
# Unset derives the callback URL from the incoming request.
OIDC_REDIRECT_URI=
# Comma-separated exact-match allow-list of app deep links the callback may
# hand tokens back to, e.g. moodverse://auth. Empty means it returns them as
# JSON instead. Anything not listed is refused - an unvalidated redirect here
# leaks a freshly issued token.
OIDC_ALLOWED_APP_REDIRECTS=

# --- background jobs: Celery, no Redis ---------------------------------------
# Broker and result backend both default to DATABASE_URL itself. Leave unset
# unless background jobs should use a different database than the app.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND_URL=
# Two independently drained queues, one worker process each.
CELERY_QUEUE_HEAVY=heavy
CELERY_QUEUE_LIGHT=light
CELERY_HEAVY_CONCURRENCY=2
CELERY_LIGHT_CONCURRENCY=4

# --- email: signup verification ----------------------------------------------
# Unset SMTP_HOST disables sending: registration still succeeds, the mail is
# logged rather than sent. STARTTLS only - implicit TLS on 465 is unsupported.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@moodverse.app
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Unset returns a JSON confirmation instead of redirecting after a verify.
EMAIL_VERIFICATION_REDIRECT_URL=
# Where the API is actually reachable; used to build the link inside the email.
PUBLIC_BASE_URL=http://localhost:8080

# --- voice: speech-to-text (Cartesia) ----------------------------------------
# Unset CARTESIA_API_KEY fails a voice reflection with a clear error rather
# than rejecting the upload.
STT_PROVIDER=cartesia
CARTESIA_API_KEY=
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_API_VERSION=2026-08-14
CARTESIA_BASE_URL=https://api.cartesia.ai
# Audio reaches the worker as base64 inside the task row, so this caps how
# much one upload can bloat the queue table.
VOICE_MAX_UPLOAD_BYTES=10000000
